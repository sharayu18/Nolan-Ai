# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI,
# rewritten for the psycopg3 driver: postgresql+psycopg://...)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nolan_ai

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Instagram Graph API — leave blank until Setup Dependencies in HANDOFF.md
# are done (Business/Creator account + Meta app approved for
# instagram_manage_insights). Analytics Agent will alert instead of
# silently failing until these are set.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# SMTP (Resend/SendGrid or any TLS SMTP relay) — for Analytics Agent alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=nolan-ai@physicsexperimental.local
ALERT_RECIPIENT_EMAIL=

# Supabase Auth — Project Settings -> API -> Project URL (same value as
# the frontend's VITE_SUPABASE_URL). Tokens are verified against this
# project's public JWKS, not a shared secret.
SUPABASE_URL=

# App
CORS_ORIGINS=http://localhost:5173
CHANNEL_HANDLE=@physicsexperimental
